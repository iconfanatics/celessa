<script>
  // Accessibility fixes for Slick Slider
  // This runs after jQuery and Slick are loaded
  document.addEventListener('DOMContentLoaded', function() {
    function fixSlickAria(slider) {
      // slick-track role="listbox" needs an accessible name or should be role="list"
      $(slider).find('.slick-track').removeAttr('role');
      
      // role="presentation" should not have aria-hidden, aria-selected, aria-controls
      $(slider).find('.slick-dots li').each(function() {
        $(this).attr('role', 'presentation');
        $(this).removeAttr('aria-hidden');
        $(this).removeAttr('aria-selected');
        $(this).removeAttr('aria-controls');
        // The button inside is what we interact with
        var button = $(this).find('button');
        button.attr('role', 'tab');
        if ($(this).hasClass('slick-active')) {
          button.attr('aria-selected', 'true');
        } else {
          button.attr('aria-selected', 'false');
        }
      });
      
      // Slides shouldn't have role="option" if track is not a listbox
      $(slider).find('.slick-slide').removeAttr('role').removeAttr('aria-describedby');
    }

    if (window.jQuery) {
      $('body').on('init', '.slick-slider', function(e, slick) {
        fixSlickAria(this);
      });
      $('body').on('afterChange', '.slick-slider', function(e, slick, currentSlide) {
        fixSlickAria(this);
      });
      $('body').on('breakpoint', '.slick-slider', function(e, slick, breakpoint) {
        fixSlickAria(this);
      });
      
      // Fix already initialized sliders
      $('.slick-slider').each(function() {
        fixSlickAria(this);
      });
    }
  });
</script>
